# Copy to .env (gitignored) and fill in. Every value is optional unless marked.

# --- Models (at least one; Groq is primary, Gemini is the fallback) ----------------
GROQ_API_KEY=
GEMINI_API_KEY=
# Experiments only (llm-kit provider); not routed by default.
OPENROUTER_API_KEY=

# --- GitHub ----------------------------------------------------------------------------
# Server token: 5,000 requests/hour instead of 60. Read-only public access is enough.
GITHUB_TOKEN=

# --- Storage ---------------------------------------------------------------------------
# Postgres (Neon). Unset = in-memory store (fine for local runs and tests; NOT for a
# multi-instance deploy such as Vercel). Use the pooled connection string on Neon.
DATABASE_URL=

# --- API -------------------------------------------------------------------------------
# Comma-separated origins allowed by CORS (the Next.js app).
WEB_ORIGIN=http://localhost:3000,http://localhost:3600
PORT=7860
# Bearer secret for /api/evals/run and /api/cron/purge (Vercel Cron sends it automatically).
CRON_SECRET=
# Salt for hashing client IPs (rate limiting). Change it in production.
IP_HASH_SALT=
# Trust X-Forwarded-For (set true behind a proxy you control; Vercel is trusted already).
TRUST_PROXY_HEADERS=false

# --- Run dispatch (serverless) ------------------------------------------------------------
# Set by Vercel itself; without QStash the client must POST /api/runs/{id}/process.
# VERCEL=1
PUBLIC_API_URL=
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# --- Observability (optional) ----------------------------------------------------------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
